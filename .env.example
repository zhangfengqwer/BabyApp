POSTGRES_DB=baby_home
POSTGRES_USER=baby_home
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://baby_home:change-me@postgres:5432/baby_home?schema=public
PORT=8080
IMMICH_BASE_URL=http://host.docker.internal:2283
IMMICH_API_KEY=replace-with-immich-api-key
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
HOME_ACCESS_KEY=replace-with-a-random-64-character-home-access-key
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-before-seeding
INITIAL_ADMIN_NICKNAME=管理员
INITIAL_BABY_NAME=安安
